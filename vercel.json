{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "https://research-production-b579.up.railway.app/api/status"
    },
    {
      "source": "/api/search",
      "destination": "https://research-production-b579.up.railway.app/api/search"
    },
    {
      "source": "/api/chat",
      "destination": "https://research-production-b579.up.railway.app/api/chat"
    },
    {
      "source": "/api/documents/:path*",
      "destination": "https://research-production-b579.up.railway.app/api/documents/:path*"
    },
    {
      "source": "/((?!api/|assets/|data/|models/|guides/|wasm/|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
