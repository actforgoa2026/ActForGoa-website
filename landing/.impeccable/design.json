      "css": ".ds-action-light{font-family:'Manrope Variable',sans-serif;font-style:normal;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:52px;padding:15px 22px;border:1px solid var(--ink,#193e32);border-radius:14px;background:var(--paper,#f7f6ee);color:var(--ink,#193e32);font-size:15px;font-weight:650;line-height:1.4;text-decoration:none;white-space:nowrap;transition:background .2s,transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s}.ds-action-light:hover{background:#e8eddd;color:var(--ink,#193e32);transform:translateY(-2px);box-shadow:0 8px 18px #193e321a}.ds-action-light:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-action-light:active{opacity:.84;transform:translateY(0)}.ds-action-light svg{flex:none}@media(prefers-reduced-motion:reduce){.ds-action-light{transition:none}.ds-action-light:hover{transform:none}}"
    },
    {
      "name": "Ghost control",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Arc ghost button primitive used by the page for menu, disclosure and motion controls.",
      "html": "<button class=\"ds-ghost\" type=\"button\" aria-label=\"Open navigation\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>",
      "css": ".ds-ghost{font-family:'Manrope Variable',sans-serif;font-style:normal;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 16px;border:1px solid transparent;border-radius:100px;background:transparent;color:var(--ink,#193e32);font-size:14px;font-weight:700;line-height:1.4;cursor:pointer;transition:background 160ms cubic-bezier(.2,0,0,1)}.ds-ghost:hover,.ds-ghost:active{background:var(--surface-muted,#e7ece3)}.ds-ghost:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-ghost:disabled{color:var(--text-muted,#627369);cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Example choice",
      "kind": "chip",
      "refersTo": "example-tab",
      "description": "Question selection uses Arc ghost buttons with an aria-pressed selected state.",
      "html": "<div class=\"ds-examples\" aria-label=\"Choose an example question\"><button class=\"ds-example\" type=\"button\" aria-pressed=\"true\">Protect a wetland</button><button class=\"ds-example\" type=\"button\" aria-pressed=\"false\">Sort out waste</button></div>",
      "css": ".ds-examples{display:flex;flex-wrap:wrap;gap:5px}.ds-example{font-family:'Manrope Variable',sans-serif;font-style:normal;padding:11px 12px;min-height:44px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--ink,#193e32);font-size:12px;font-weight:700;line-height:1.4;cursor:pointer;transition:background .2s}.ds-example[aria-pressed=true]{background:#e9efdf}.ds-example:hover{background:#eff2e9}.ds-example:active{background:var(--surface-muted,#e7ece3)}.ds-example:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-example{transition:none}}"
    },
    {
      "name": "Source link",
      "kind": "chip",
      "refersTo": "source-link",
      "description": "Nearby source destinations remain ordinary outlined anchors.",
      "html": "<a class=\"ds-source\" href=\"https://actforgoa-field-guide.vercel.app/research-library\" target=\"_blank\" rel=\"noreferrer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14m0-14C10 5 6 4 2 5v15c4-1 8 0 10 1m0-14c2-2 6-3 10-2v15c-4-1-8 0-10 1\"/></svg><span>Wetlands &amp; conservation</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-source{font-family:'Manrope Variable',sans-serif;font-style:normal;display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:9px;border:1px solid #d5ddcd;border-radius:6px;color:var(--ink,#193e32);font-size:12px;font-weight:500;text-decoration:none;line-height:1.4}.ds-source:hover{background:#ecf1e3}.ds-source:active{background:var(--surface-muted,#e7ece3)}.ds-source:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-source svg{width:15px;height:15px;flex:none}"
    },
    {
      "name": "Floating navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "The solid paper navigation group combines the upright wordmark, links and Arc menu trigger.",
      "html": "<div class=\"ds-navigation\"><a class=\"ds-brand\" href=\"#top\">actforgoa<span class=\"ds-brand-dot\">.</span></a><nav class=\"ds-nav-links\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#intelligence\">The intelligence</a><a class=\"ds-nav-link\" href=\"#in-action\">See it in action</a></nav><button class=\"ds-nav-toggle\" type=\"button\" aria-label=\"Open navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button></div>",
      "css": ".ds-navigation{font-family:'Manrope Variable',sans-serif;font-style:normal;display:flex;align-items:center;gap:26px;min-height:64px;padding:11px 14px 11px 24px;border-radius:18px;background:#efefe5;color:var(--ink,#193e32);box-shadow:0 5px 25px #193e3205}.ds-brand{color:inherit;font-size:27px;font-weight:850;letter-spacing:-.04em;text-decoration:none;white-space:nowrap}.ds-brand-dot{color:#638554}.ds-nav-links{display:flex;gap:23px}.ds-nav-link{padding:14px 0;color:inherit;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap}.ds-nav-link:hover{text-decoration:underline;text-underline-offset:5px}.ds-nav-toggle{display:grid;place-items:center;width:38px;min-height:40px;background:transparent;color:inherit;border:0;border-radius:100px;cursor:pointer}.ds-nav-toggle:hover,.ds-nav-toggle:active{background:var(--surface-muted,#e7ece3)}.ds-brand:focus-visible,.ds-nav-link:focus-visible,.ds-nav-toggle:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(max-width:600px){.ds-nav-links{display:none}.ds-navigation{gap:14px}}"
    },
    {
      "name": "Illustrative answer window",
      "kind": "card",
      "refersTo": "answer-window",
      "description": "A single raised window keeps question, answer and illustration notice together.",
      "html": "<article class=\"ds-answer\"><div class=\"ds-answer-top\">actforgoa.</div><div class=\"ds-answer-body\"><p class=\"ds-question\">How can we protect a wetland near our village?</p><h3 class=\"ds-answer-title\">Start with the place. Follow the evidence.</h3><p class=\"ds-answer-copy\">Explore how the wetland is recorded, which protections may apply, and where to take your concern.</p><p class=\"ds-answer-note\">Illustrative walkthrough · explore the real sources</p></div></article>",
      "css": ".ds-answer{font-family:'Manrope Variable',sans-serif;font-style:normal;width:100%;max-width:680px;overflow:hidden;border:1px solid #d3dbcd;border-radius:22px;background:var(--white,#fffef8);color:var(--ink,#193e32);box-shadow:0 28px 60px -15px #193e3220}.ds-answer-top{padding:22px 26px;border-bottom:1px solid #e4e7dd;font-size:21px;font-weight:850;letter-spacing:-.04em}.ds-answer-body{padding:24px}.ds-question{margin:0 0 27px;padding:18px 20px;border-radius:13px;background:#eff1e9;font-size:15px;font-weight:600;line-height:1.4}.ds-answer-title{margin:0 0 12px;font-size:21px;font-weight:650;line-height:1.3;letter-spacing:-.025em}.ds-answer-copy{max-width:65ch;margin:0;color:#4e6254;font-size:14px;font-weight:500;line-height:1.75}.ds-answer-note{margin:24px 0 0;padding-top:17px;border-top:1px solid var(--line,#d4dacd);color:var(--muted,#54685b);font-size:11px;line-height:1.6}"
    },
    {
      "name": "Question composer",
      "kind": "input",
      "refersTo": "question-composer",
      "description": "The landing composer integrates the labelled Arc Input with a question action; this specimen has no live submission.",
      "html": "<div class=\"ds-composer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><label class=\"ds-hidden\" for=\"ds-goa-question\">Your question about Goa</label><input class=\"ds-question-input\" id=\"ds-goa-question\" name=\"q\" placeholder=\"Ask a question about Goa…\" maxlength=\"2000\" required/><button class=\"ds-submit\" type=\"button\" aria-label=\"Ask your question in ActForGoa AI\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></div>",
      "css": ".ds-composer{font-family:'Manrope Variable',sans-serif;font-style:normal;display:flex;align-items:center;gap:18px;max-width:680px;padding:13px 14px 13px 23px;border:1px solid #bcc9b2;border-radius:17px;background:var(--white,#fffef8);color:var(--ink,#193e32);box-shadow:0 14px 30px #193e3208}.ds-composer:focus-within{background:#eef2e4}.ds-question-input{font-family:'Manrope Variable',sans-serif;font-style:normal;flex:1;min-width:0;min-height:46px;padding:10px 0;border:0;outline:none;background:transparent;color:var(--ink,#193e32);font-size:15px;font-weight:500;line-height:1.4;caret-color:var(--ink,#193e32)}.ds-question-input::placeholder{color:#5e6d57;opacity:1}.ds-submit{display:grid;place-items:center;flex:none;width:48px;height:48px;border:0;border-radius:12px;background:var(--ink,#193e32);color:var(--paper,#f7f6ee);cursor:pointer}.ds-submit:hover,.ds-submit:active{background:#345c43}.ds-submit:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-submit:disabled{background:#d7ddce;color:#526346;cursor:not-allowed}.ds-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}@media(max-width:599px){.ds-question-input{font-size:16px}.ds-composer{gap:10px;padding:10px 10px 10px 14px}}"
    },
    {
      "name": "Resource disclosure",
      "kind": "custom",
      "description": "An open resource row with a visible selected explanation; React and Arc Button own its real expansion behavior.",
      "html": "<section class=\"ds-resource\"><h3 class=\"ds-resource-heading\"><button class=\"ds-resource-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"ds-resource-description\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14m0-14C10 5 6 4 2 5v15c4-1 8 0 10 1m0-14c2-2 6-3 10-2v15c-4-1-8 0-10 1\"/></svg><span class=\"ds-resource-label\">A living source library</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></button></h3><div class=\"ds-resource-description\" id=\"ds-resource-description\"><p class=\"ds-resource-copy\">Go straight to the documents, handbooks and research behind the conversation.</p><a class=\"ds-resource-link\" href=\"https://actforgoa-field-guide.vercel.app/research-library\" target=\"_blank\" rel=\"noreferrer\">Explore the library <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></div></section>",
      "css": ".ds-resource{font-family:'Manrope Variable',sans-serif;font-style:normal;max-width:620px;border-top:1px solid #c4cebb;border-bottom:1px solid #c4cebb;background:#e9eddf;color:var(--ink,#193e32)}.ds-resource-heading{margin:0}.ds-resource-button{font-family:'Manrope Variable',sans-serif;font-style:normal;display:flex;align-items:center;gap:16px;width:100%;padding:27px 0;border:0;background:transparent;color:inherit;font-size:24px;font-weight:700;letter-spacing:-.025em;text-align:left;cursor:pointer}.ds-resource-label{flex:1}.ds-resource-button:hover{background:var(--surface-muted,#e7ece3)}.ds-resource-button:active{background:#e9efdf}.ds-resource-button:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-resource-description{padding:0 40px 25px}.ds-resource-copy{max-width:40ch;margin:0 0 15px;color:var(--muted,#54685b);font-size:16px;line-height:1.6}.ds-resource-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:inherit;font-size:15px;font-weight:650;text-decoration:none}.ds-resource-link:hover{text-decoration:underline;text-underline-offset:5px}.ds-resource-link:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"
    }
  ],
  "narrative": {
    "northStar": "Goa's knowledge, in the open",
    "overview": "The landing page gives local knowledge room to speak. Warm paper, forest ink and upright Manrope create a spacious editorial surface; fine stippled Goa illustrations add a recognisable sense of place. Large headings and concrete explanations lead to an existing AI service, original documents, practical guides and local organisations.\n\nThe user-pinned Butter reference supplies the floating navigation, generous intervals and staged scroll choreography. ActForGoa supplies the content, palette, artwork and actual product screenshots. Soft depth belongs to the product preview, source sheets and interactive surfaces. Lime marks selected narrative passages; it is not a general backdrop for every component.",
    "keyCharacteristics": [
      "Warm paper and forest ink, with deliberate lime passages.",
      "Upright self-hosted Manrope and large, lightly weighted display type.",
      "Natural illustration proportions, open compositions and generous section spacing.",
      "Actual Arc buttons, anchor buttons and input with preserved semantics and provenance.",
      "Visible source links, explicit illustrative examples and a complete reduced-motion flow."
    ],
    "rules": [
      {
        "name": "The Contrast Pair Rule",
        "body": "Place forest text on paper or lime, and paper text on forest. Keep the primary action easy to distinguish from its surrounding surface.",
        "section": "colors"
      },
      {
        "name": "The Upright Type Rule",
        "body": "Use upright type everywhere. Emphasis comes from weight, size, spacing and position; never italic or oblique styling.",
        "section": "typography"
      },
      {
        "name": "The Concrete Copy Rule",
        "body": "Headings and actions say what the visitor can ask, read, find or do. Do not add eyebrow labels, provider-brand claims or small abstract fragments around them.",
        "section": "typography"
      },
      {
        "name": "The Natural Proportion Rule",
        "body": "Preserve raster width-to-height relationships and motif aspect ratios at every breakpoint. Panoramas may extend beyond the viewport and crop at the edges; they must not stretch. The product screenshot uses its original 16:9 ratio with `object-fit: contain`.",
        "section": "layout"
      },
      {
        "name": "The Complete Static Flow Rule",
        "body": "Reduced motion and the persistent Pause motion preference expose every narrative section in document order. Disabling animation must never hide the source fan, example answer or later journey panels.",
        "section": "elevation & depth"
      },
      {
        "name": "The Structural Line Rule",
        "body": "Full control borders and horizontal section rules convey structure. Never use a decorative accent stripe along one side of a content block.",
        "section": "shapes"
      },
      {
        "name": "The Source Proximity Rule",
        "body": "Keep source links and uncertainty beside the claims they qualify. Distinguish illustrative examples, real product screenshots and generated decoration in both visible copy and provenance.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep this Manrope system scoped to the landing surface.",
      "Do use the actual installed Arc sources and preserve their semantics, states and provenance.",
      "Do preserve natural image proportions and distinguish decorative artwork from source evidence.",
      "Do use concrete copy and keep original-source links and practical uncertainty visible.",
      "Do retain keyboard focus, labelled controls and the complete reduced-motion reading flow.",
      "Do keep AI actions connected to the existing service and examples visibly illustrative."
    ],
    "donts": [
      "Don't replace the main application's Figtree design system with this landing system.",
      "Don't use italic or oblique text, eyebrow labels or decorative side stripes.",
      "Don't stretch images, force organic motifs into square silhouettes or invent product screenshots.",
      "Don't restore AI-provider branding or small abstract copy fragments removed by the user.",
      "Don't imply that curated sources guarantee correct answers, current rules or available contacts.",
      "Don't treat documentation or source inspection as final rendered acceptance or publication evidence."
    ]
  }
}
