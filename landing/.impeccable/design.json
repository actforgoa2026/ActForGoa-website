  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The mounted Arc ButtonLink action with the landing treatment; its real React source owns press motion.",
      "html": "<a class=\"ds-action\" href=\"https://actforgoa-field-guide.vercel.app/ai\" target=\"_blank\" rel=\"noreferrer\"><span>Ask ActForGoa AI</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-action{font-family:'Manrope Variable',sans-serif;font-style:normal;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:52px;padding:15px 22px;border:1px solid var(--ink,#193e32);border-radius:14px;background:var(--ink,#193e32);color:var(--paper,#f7f6ee);font-size:15px;font-weight:650;line-height:1.4;text-decoration:none;white-space:nowrap;transition:background .2s,transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s}.ds-action:hover{background:#2a5544;transform:translateY(-2px);box-shadow:0 8px 18px #193e321a}.ds-action:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-action:active{opacity:.84;transform:translateY(0)}.ds-action svg{flex:none}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}.ds-action:hover{transform:none}}"
    },
