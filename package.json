{
  "name": "actforgoa-field-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-reporting.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "crawl": ".venv/bin/python scripts/crawl.py",
    "extract": ".venv/bin/python scripts/extract.py",
    "audit:links": ".venv/bin/python scripts/audit_links.py",
    "index:semantic": "node scripts/embeddings.mjs",
    "research:ingest": ".venv/bin/python scripts/ingest_ecology.py",
    "research:index": ".venv/bin/python scripts/build_research_index.py",
    "research:api": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8091",
    "research:dev": ".venv/bin/python scripts/serve_research.py",
    "research:test": ".venv/bin/python -m pytest tests/research -q",
    "research:evaluate": ".venv/bin/python scripts/evaluate_research.py",
    "dev:reports": "node --import tsx server/reporting.ts",
    "start:reports": "node --import tsx server/reporting.ts",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  }
}
