# Server only. Save real credentials in .env.local, never in VITE_* or Git.
RESEARCH_CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
# Optional direct Alibaba connection, used only with RESEARCH_CHAT_PROVIDER=qwen.
DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen3.7-flash-2026-07-15
# Optional: use a Singapore workspace-dedicated endpoint from Model Studio.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
RESEARCH_MONTHLY_ANSWER_BUDGET_USD=5
RESEARCH_DAILY_ANSWER_LIMIT=100
# Optional alternative, used only with RESEARCH_CHAT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Direct Anthropic, used only with RESEARCH_CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# Required only for an API key that is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
