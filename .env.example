# Server only. Save real credentials in .env.local, never in VITE_* or Git.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# Enable only after the restored corpus, accounting and live answer checks pass.
RESEARCH_CHAT_ENABLED=0
RESEARCH_MONTHLY_BUDGET_USD=5
RESEARCH_DAILY_ANSWER_LIMIT=100
# Existing public service: preserve its ledger; never start a replacement budget.
RESEARCH_REQUIRE_EXISTING_USAGE=1

# Vercel server-only origin for the persistent internal-tool service.
ADMIN_API_ORIGIN=
# Internal-tool service: exact frontend origin and private persistent storage.
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:4173
ADMIN_DATA_DIR=.reports/admin
ADMIN_PORT=4188
ADMIN_BEHIND_FRONTEND_PROXY=true
